<div class="company-header">
  {{#if company.logoUrl}}<img class="logo" src="{{company.logoUrl}}" alt="logo">{{/if}}
  {{#if company.name}}<div class="company-name">{{company.name}}</div>{{/if}}
  {{#if company.address}}<div class="company-address">{{company.address}}</div>{{/if}}
  {{#if company.vatNumber}}<div class="company-address">VAT Number: {{company.vatNumber}}</div>{{/if}}
  {{#if company.registrationNumber}}<div class="company-address">Registration Number: {{company.registrationNumber}}</div>{{/if}}
</div>
