# Database
URI=mongodb://127.0.0.1:27017/maqvera
PRIVATE_KEY=replace-with-a-long-random-secret

# Identity & Authentication (Login / MFA / sessions — docs/05-api/03-auth-api.md)
# Critical: startup fails (config/envValidator.js) if these are missing or left insecure.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Access/refresh token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_DAYS=30
# Used only when the login request sets rememberMe=true
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_IN=90d
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_DAYS=90
# Login lockout policy
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Require an active tenant/branch/role for every login (see Login business rules)
STRICT_AUTH_DOMAIN=false
# Optional. Only set this for a genuinely single-tenant on-prem deployment:
# lets POST /auth/signup omit tenantKey and join this tenant implicitly.
# Leave unset for normal multi-tenant/SaaS use — signup then requires an
# explicit tenantKey, and new companies register via POST /auth/setup.
# DEFAULT_TENANT_KEY=
# Auth endpoint rate limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=100
# MFA challenge lifetimes
MFA_CODE_TTL_MINUTES=10
MFA_TOKEN_TTL_MINUTES=10
# GET /auth/me is called on every page load/refresh; audit it only if you need that trail
ME_ENDPOINT_AUDIT_ENABLED=false
# Whether POST /auth/change-password revokes the user's other active sessions
CHANGE_PASSWORD_REVOKE_OTHER_SESSIONS=true
# Minimum seconds between reset-token issuances for the same user (abuse/email-bombing guard)
FORGOT_PASSWORD_COOLDOWN_SECONDS=60
# GET /auth/sessions is a routine "view my devices" call; audit it only if you need that trail
SESSIONS_LIST_AUDIT_ENABLED=false
# Minimum seconds between invitation resends for the same employee (abuse/email-bombing guard)
RESEND_INVITATION_COOLDOWN_SECONDS=60
# Offline IP-to-country/city lookup (geoip-lite) used for session/login-history location fields.
# No API key needed; set to false to disable resolution entirely (e.g. privacy/compliance).
SESSION_GEO_LOCATION_ENABLED=true
# SMTP — required for email-based MFA codes, verification, and reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=MAQVERA
EMAIL_FROM=

# Passport identifiers (optional format overrides)
PASSPORT_DISPATCH_PREFIX=DISP
PASSPORT_RECEIPT_PREFIX=RCP
INCIDENT_NUMBER_PREFIX=INC
VISA_CASE_NUMBER_PREFIX=VIS
INCIDENT_DEFAULT_ASSIGNMENT_TEAM=Operations
TIMELINE_MAX_NOTE_LENGTH=5000

# Courier provider integration. Leave both unset to retain manual tracking.
COURIER_API_BASE_URL=https://courier-provider.example/api
COURIER_API_KEY=replace-with-courier-api-key

# Redis Cache (optional — falls back to in-memory if unset)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=maqvera:

# Document storage. Use one configured backend; secrets remain only in .env.
FILE_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_STORAGE_BASE_URL=
DOCUMENT_SIGNING_SECRET=replace-with-a-long-random-secret
# JSON array overrides — leave unset to use the built-in defaults
DOCUMENT_ALLOWED_MIME_TYPES_JSON=
SUPPORTED_DOCUMENT_TYPES_JSON=
# S3_ENDPOINT above also covers any S3-compatible provider (e.g. Cloudflare
# R2, MinIO) — set FILE_STORAGE_BACKEND=s3 and point S3_ENDPOINT at it.
# Document retention (days an archived document's metadata is kept before
# being eligible for a manual/future purge pass — no automated deletion runs)
DOCUMENT_RETENTION_DAYS=2555
# Document expiry check + reminder scheduler
DOCUMENT_EXPIRY_CRON_SCHEDULE=0 3 * * *
DOCUMENT_EXPIRY_REMINDER_DAYS=30
# Appointment reminder + missed-appointment sweep
APPOINTMENT_REMINDER_CRON_SCHEDULE=*/15 * * * *
# Cloudinary (required only when FILE_STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maqvera-documents
# S3-compatible object storage (required only when FILE_STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FOLDER=maqvera-documents

# utils/fileStorage.js — a separate, general-purpose object-storage helper
# (saveBookingDocumentFile) reused by incident attachments and, as of
# EXT-010, boarding pass storage. Pre-existing but previously undocumented;
# documented now since EXT-010 depends on it. Distinct env-var names from
# the FILE_STORAGE_BACKEND/S3_* block above (that one backs
# services/FileUploadService.js / EnterpriseDocumentService).
BOOKING_DOCUMENT_STORAGE_PROVIDER=local
BOOKING_DOCUMENT_STORAGE_PATH=
BOOKING_DOCUMENT_PUBLIC_BASE_URL=http://localhost:5000/uploads/booking-documents
# Required only when BOOKING_DOCUMENT_STORAGE_PROVIDER=s3 (uses the AWS SDK directly)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# EXT-010 — Airline Flight Check-in. No airline exposes a public,
# installable check-in SDK the way Amadeus does for search/pricing/booking;
# a real per-airline integration requires that airline's own commercial API
# credentials, configured per code below. Every airline is honestly
# "unsupported" (falls back to their real web check-in portal) until
# configured — utils/airlineCheckInConfig.js.
AIRLINE_CHECKIN_TIMEOUT_MS=15000
# Optional override of the built-in airline name/redirect-URL registry
# AIRLINE_CHECKIN_REGISTRY_JSON={"EK":{"airlineName":"Emirates","checkInUrl":"https://www.emirates.com"}}
# Per-airline real API credentials (example shape — replace CODE with the real IATA airline code, e.g. EK, QR, TK, SV, PK)
# AIRLINE_CHECKIN_EK_BASE_URL=
# AIRLINE_CHECKIN_EK_API_KEY=

# Dashboard & Analytics
DASHBOARD_CACHE_TTL_SECONDS=60
# How many trailing days GET /bookings/dashboard's "Booking Trends" series covers
BOOKING_DASHBOARD_TREND_DAYS=14
ANALYTICS_CRON_SCHEDULE=*/5 * * * *
ANALYTICS_NIGHTLY_CRON_SCHEDULE=0 2 * * *
# Max span allowed for GET /dashboard/trends?dateFrom=&dateTo= (Custom Date Range)
DASHBOARD_TREND_MAX_RANGE_DAYS=366

# Enterprise Search (MongoDB read-model backend)
ENTERPRISE_SEARCH_MAX_PAGE_SIZE=100
# Redis-backed cache TTL for GET /search result pages (via CacheManager)
SEARCH_CACHE_TTL_SECONDS=30
# Fuzzy fallback (Levenshtein): max edit distance considered a match, and how
# many recent index rows to scan as candidates when the exact pass finds none
SEARCH_FUZZY_MAX_DISTANCE=2
SEARCH_FUZZY_CANDIDATE_LIMIT=500

# Retry policy for transient external-service calls (object storage uploads)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300

# Idempotency-Key support (opt-in, via the Idempotency-Key request header)
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Customer Management (utils/customerConfig.js)
CUSTOMER_CODE_PREFIX=CUS
DEFAULT_CUSTOMER_BRANCH=KARACHI
DEFAULT_CUSTOMER_CATEGORY=regular
DEFAULT_CUSTOMER_STATUS=active
DEFAULT_CUSTOMER_LANGUAGE=en
DEFAULT_CUSTOMER_CURRENCY=USD
DEFAULT_CUSTOMER_TIMEZONE=UTC
CUSTOMER_ENABLE_DUPLICATE_DETECTION=true
# Minimum duplicate-detection score (0-100, see the Customer Duplicate
# Detection score table) required to block customer creation with a 409.
CUSTOMER_DUPLICATE_SCORE_THRESHOLD=85
CUSTOMER_DEFAULT_PAGE_SIZE=20
CUSTOMER_MAX_PAGE_SIZE=100
CUSTOMER_ENABLE_VERSIONING=true
CUSTOMER_ENABLE_TIMELINE=true
DEFAULT_CUSTOMER_COMMUNICATION_CHANNEL=whatsapp
DEFAULT_CUSTOMER_DOCUMENT_STATUS=pending_scan
DEFAULT_CUSTOMER_DOCUMENT_VISIBILITY=internal
DEFAULT_CUSTOMER_DOCUMENT_CATEGORY=Identity
DEFAULT_CUSTOMER_NOTE_CATEGORY=General
DEFAULT_CUSTOMER_NOTE_VISIBILITY=Internal
CUSTOMER_ALLOWED_NOTE_CATEGORIES=Customer Service,Sales,Finance,Visa,Travel,Medical,Operations,Support,General
CUSTOMER_ALLOWED_NOTE_VISIBILITIES=Internal,Management,Branch,Private
DEFAULT_CUSTOMER_MEAL_PREFERENCE=halal
DEFAULT_CUSTOMER_SEAT_PREFERENCE=no_preference
DEFAULT_CUSTOMER_NOTIFICATION_PREFERENCES={"email":true,"sms":true,"whatsapp":true,"push":false}
# Falls back to FILE_STORAGE_BACKEND/FILE_STORAGE_PROVIDER above if unset.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PROVIDER=Local
CUSTOMER_ALLOWED_FAMILY_RELATIONSHIPS=father,mother,husband,wife,spouse,son,daughter,brother,sister,guardian,mahram,friend,other
CUSTOMER_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/heic,image/tiff,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# How long a customer document's signed download URL stays valid (see
# DOCUMENT_SIGNING_SECRET/DOCUMENT_STORAGE_BASE_URL above, which generate it).
CUSTOMER_DOCUMENT_SIGNED_URL_TTL_SECONDS=900

# Booking Management (utils/bookingConfig.js)
DEFAULT_BRANCH_ID=KARACHI
DEFAULT_CURRENCY=USD
DEFAULT_BOOKING_TYPE=umrah
DEFAULT_BOOKING_STATUS=draft
DEFAULT_BOOKING_PRIORITY=normal
DEFAULT_PAYMENT_STATUS=unpaid
DEFAULT_VISA_STATUS=pending
DEFAULT_TRAVELER_TYPE=adult
DEFAULT_TRAVELER_STATUS=registered
DEFAULT_SERVICE_WORKFLOW_STATUS=created
DEFAULT_SERVICE_STATUS=active
DEFAULT_BOOKING_DOCUMENT_STATUS=pending_scan
DEFAULT_SERVICE_PRIORITY=normal
AUTO_CREATE_BOOKING_WORKFLOW=true
DEFAULT_BOOKING_PAGE_SIZE=20
MAX_BOOKING_PAGE_SIZE=100
# Advanced overrides — each is a JSON array; see utils/bookingConfig.js for the
# default shape (booking types/statuses/service types/workflow states &
# transitions). Leave unset to use the built-in defaults, which already cover
# the full Booking Lifecycle (Part 1) including partially_paid/refunded/rejected.
# BOOKING_TYPES_JSON=
# BOOKING_STATUSES_JSON=
# BOOKING_PAYMENT_STATUSES_JSON=
# BOOKING_VISA_STATUSES_JSON=
# BOOKING_TRAVELER_TYPES_JSON=
# BOOKING_TRAVELER_STATUSES_JSON=
# BOOKING_WORKFLOW_DEFINITIONS_JSON=
# BOOKING_WORKFLOW_STATES_JSON=
# BOOKING_SERVICE_TYPES_JSON=
# BOOKING_SERVICE_CATEGORIES_JSON=
# BOOKING_SERVICE_WORKFLOW_STATUSES_JSON=
# SUPPORTED_CURRENCIES_JSON=

# Travel Operations (utils/travelConfig.js)
DEFAULT_TRAVEL_TYPE=umrah
DEFAULT_TRAVEL_STATUS=planning
DEFAULT_TRAVEL_PRIORITY=normal
DEFAULT_TRAVEL_PAGE_SIZE=20
MAX_TRAVEL_PAGE_SIZE=100
# Advanced overrides — each is a JSON array; see utils/travelConfig.js for the
# default shape (travel types/statuses/roles/workflow states & transitions).
# Leave unset to use the built-in defaults, which already cover the full
# Travel Lifecycle (Part 1) including its named exception states.
# TRAVEL_TYPES_JSON=
# TRAVEL_STATUSES_JSON=
# TRAVEL_ROLES_JSON=
# TRAVEL_WORKFLOW_DEFINITIONS_JSON=
# TRAVEL_WORKFLOW_STATES_JSON=

# Flight Operations (utils/flightConfig.js)
DEFAULT_FLIGHT_STATUS=scheduled
# Advanced overrides — each is a JSON array; see utils/flightConfig.js for the
# default shape (statuses/delay types/incident severities/workflow states &
# transitions). Leave unset to use the built-in defaults, which already cover
# the full Flight Lifecycle (Part 3) including its named exceptions.
# FLIGHT_STATUSES_JSON=
# FLIGHT_DELAY_TYPES_JSON=
# FLIGHT_INCIDENT_SEVERITIES_JSON=
# FLIGHT_WORKFLOW_DEFINITIONS_JSON=
# FLIGHT_WORKFLOW_STATES_JSON=

# Hotel Operations (utils/hotelConfig.js)
DEFAULT_HOTEL_STATUS=planned
# Advanced overrides — each is a JSON array/object; see utils/hotelConfig.js
# for the default shape (statuses/meal plans/incident severities/room-type
# capacities/workflow states & transitions). Leave unset to use the built-in
# defaults, which already cover the full Hotel Lifecycle (Part 4) including
# its named exceptions.
# HOTEL_STATUSES_JSON=
# HOTEL_MEAL_PLANS_JSON=
# HOTEL_INCIDENT_SEVERITIES_JSON=
# HOTEL_ROOM_TYPE_CAPACITIES_JSON=
# HOTEL_WORKFLOW_DEFINITIONS_JSON=
# HOTEL_WORKFLOW_STATES_JSON=

# Transport Management (utils/transportConfig.js)
DEFAULT_TRANSPORT_STATUS=planned
# Advanced overrides — each is a JSON array; see utils/transportConfig.js for
# the default shape (statuses/incident severities/workflow states &
# transitions). Leave unset to use the built-in defaults, which already
# cover the full Transport Lifecycle (Part 5) including its named exceptions.
# TRANSPORT_STATUSES_JSON=
# TRANSPORT_INCIDENT_SEVERITIES_JSON=
# TRANSPORT_WORKFLOW_DEFINITIONS_JSON=
# TRANSPORT_WORKFLOW_STATES_JSON=

# Itinerary Management (utils/itineraryConfig.js)
DEFAULT_ACTIVITY_STATUS=planned
# IANA timezone used to interpret plannedStart/plannedEnd wall-clock input
# when an activity doesn't specify its own timezone (utils/itineraryConfig.js,
# controllers/TravelItineraryController.js — powered by the luxon package).
DEFAULT_ITINERARY_TIMEZONE=Asia/Riyadh
DEFAULT_ACTIVITY_DURATION_MINUTES=60
# Advanced overrides — each is a JSON array; see utils/itineraryConfig.js for
# the default shape (activity types/statuses/workflow states & transitions).
# Leave unset to use the built-in defaults, which already cover the full
# Itinerary Lifecycle (Part 6) including its named exceptions.
# ITINERARY_ACTIVITY_TYPES_JSON=
# ITINERARY_ACTIVITY_STATUSES_JSON=
# ITINERARY_WORKFLOW_DEFINITIONS_JSON=
# ITINERARY_WORKFLOW_STATES_JSON=

# Attendance Management (utils/attendanceConfig.js)
DEFAULT_ATTENDANCE_STATUS=Scheduled
# Advanced overrides — see utils/attendanceConfig.js for the default shape
# (statuses/verification methods/default policy/workflow states &
# transitions). Leave unset to use the built-in defaults, which already
# cover the full Attendance Lifecycle (Part 7) including its named
# exceptions and the doc's "Attendance window configurable"/"Late threshold
# configurable" business rules.
# ATTENDANCE_STATUSES_JSON=
# ATTENDANCE_VERIFICATION_METHODS_JSON=
# ATTENDANCE_DEFAULT_POLICY_JSON={"checkInWindowMinutes":30,"lateThresholdMinutes":10,"missingThresholdMinutes":20,"emergencyNotifyImmediate":true,"autoCloseAfterWindow":true}
# ATTENDANCE_WORKFLOW_DEFINITIONS_JSON=
# ATTENDANCE_WORKFLOW_STATES_JSON=

# Incident Management (utils/incidentConfig.js) — real fallback defaults for
# tenants without a seeded IncidentPolicyModel (npm run seed:incident-policy
# still remains the source of truth when a policy document exists).
# INCIDENT_CATEGORIES_JSON=
# INCIDENT_LOCKING_CATEGORIES_JSON=
# INCIDENT_SEVERITIES_JSON=
# INCIDENT_SOURCES_JSON=
# INCIDENT_ESCALATION_CHAIN_JSON=
INCIDENT_ATTACHMENT_MAX_SIZE_BYTES=26214400
# INCIDENT_ATTACHMENT_MIME_TYPES_JSON=

# Incident SLA sweep — services/incidentSlaScheduler.js. Flags breached
# first-response/resolution SLAs and walks INCIDENT_ESCALATION_CHAIN_JSON.
INCIDENT_SLA_SWEEP_CRON_SCHEDULE=*/10 * * * *

# Notes & Timeline (utils/notesTimelineConfig.js)
# Advanced overrides — see utils/notesTimelineConfig.js for the default
# shape (visibility options/event types/sources/attachment MIME allowlist).
# NOTES_VISIBILITY_OPTIONS_JSON=
# NOTES_TIMELINE_EVENT_TYPES_JSON=
# NOTES_TIMELINE_SOURCES_JSON=
# NOTES_ATTACHMENT_MIME_TYPES_JSON=
NOTES_ATTACHMENT_MAX_SIZE_BYTES=26214400

# Travel Dashboard AI Insights (services/KPIEngine.js generateTravelAIInsights)
# Real, deterministic day-over-day comparison thresholds — not ML, just
# configurable sensitivity for when a metric swing is worth surfacing.
AI_INSIGHT_HEALTH_SCORE_THRESHOLD=5
AI_INSIGHT_DELAY_THRESHOLD_MINUTES=5
AI_INSIGHT_INCIDENT_TREND_THRESHOLD=2
AI_INSIGHT_HOTEL_TREND_THRESHOLD_PCT=10

# GDS Integration — Flight Search (API-006B). Live credentials are optional:
# without them, adapters fall back to an honestly-labeled dynamic sandbox
# generator (meta.provider = "<Provider> Dynamic Engine", never presented as
# live data) rather than failing outright.
AMADEUS_CLIENT_ID=YOUR_AMADEUS_CLIENT_ID
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_CLIENT_SECRET
AMADEUS_BASE_URL=https://test.api.amadeus.com
# SABRE_CLIENT_ID currently only flips the provider health check between
# LIVE_API/DYNAMIC_SANDBOX — SabreAdapter has no real HTTP integration yet.
SABRE_CLIENT_ID=YOUR_SABRE_CLIENT_ID
GDS_PRIMARY_PROVIDER=Amadeus
GDS_SECONDARY_PROVIDER=Sabre
GDS_DEFAULT_CURRENCY=PKR
GDS_DEFAULT_ORIGIN=KHI
GDS_DEFAULT_DESTINATION=JED
# Search validation policy (utils/gdsConfig.js getFlightSearchValidationConfig)
GDS_MAX_PASSENGERS=9
GDS_MAX_ADVANCE_BOOKING_DAYS=365
# GDS_SUPPORTED_CABINS_JSON=["Economy","PremiumEconomy","Business","First"]
# GDS_SUPPORTED_CURRENCIES_JSON=["PKR","USD","SAR","AED","EUR","GBP"]
# Provider resilience — timeout protection, retry, circuit breaker
GDS_REQUEST_TIMEOUT_MS=8000
GDS_MAX_RETRIES=1
GDS_CIRCUIT_BREAKER_THRESHOLD=3
GDS_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# EXT-002 — gdsHttpClient's own HTTP-level retry/backoff against Amadeus
# (distinct from GDS_MAX_RETRIES, which retries a whole adapter method call)
GDS_AMADEUS_HTTP_MAX_RETRIES=3
GDS_AMADEUS_HTTP_BACKOFF_BASE_MS=500
# "No cached fares longer than configured TTL" — shared by both the
# internal (API-006B/E) and external (EXT-002) flight/hotel search caches
GDS_SEARCH_CACHE_TTL_SECONDS=600
# EXT-003 — Amadeus Flight Pricing. Distinct, longer-timeout/single-retry
# policy from the general GDS_REQUEST_TIMEOUT_MS/GDS_MAX_RETRIES above —
# pricing calls are allowed to take longer and must never share the more
# aggressive search retry budget.
AMADEUS_PRICING_TIMEOUT_MS=30000
AMADEUS_PRICING_MAX_RETRIES=1
# Max age (seconds) a flightOffer from EXT-002's search can be before
# pricing verification rejects it as INVALID_FLIGHT_OFFER (expired)
AMADEUS_PRICING_MAX_OFFER_AGE_SECONDS=600
# Dynamic-sandbox fallback values used only when live credentials are absent
# or the live call fails — see utils/gdsConfig.js for the full default set.
# GDS_FALLBACK_FLIGHT_BASE_PRICE=145000
# GDS_FALLBACK_AIRLINE=Saudi Airlines
# GDS_FALLBACK_AIRLINE_CODE=SV

# Flight Ticketing & PNR Management (API-006D) — utils/gdsConfig.js getTicketingPolicyConfig()
GDS_TICKET_VOID_WINDOW_HOURS=24
GDS_DEFAULT_CANCELLATION_PENALTY_PCT=20
# GDS_SUPPORTED_SSR_CODES_JSON=["WCHR","SPML","INFT","EXST","MEDA","PETC","UMNR","OTHS"]
# GDS_SUPPORTED_OSI_TYPES_JSON=["VIP Passenger","Language Preference","Special Handling","Corporate Traveler","Medical Notes"]
# GDS_SUPPORTED_EMD_TYPES_JSON=["Extra Baggage","Seat Upgrade","Lounge Access","Sports Equipment","Priority Boarding","Wi-Fi","Meal Upgrade"]

# EXT-005 — Amadeus Flight Ticketing. "Automatic Retry, 3 Attempts,
# Exponential Backoff" — utils/gdsConfig.js getTicketIssuanceRetryPolicy()
GDS_TICKET_ISSUANCE_MAX_ATTEMPTS=3
GDS_TICKET_ISSUANCE_BACKOFF_BASE_MS=500

# EXT-008 — Amadeus Seat Map. "Cache lifetime = 5 minutes" —
# utils/gdsConfig.js getSeatMapPolicy()
GDS_SEAT_MAP_CACHE_TTL_SECONDS=300
GDS_SEAT_MAP_TIMEOUT_MS=15000
GDS_SEAT_MAP_MAX_RETRIES=1

# EXT-011 — Amadeus Flight Status. Read-only, deliberately uncached ("always
# live") — utils/gdsConfig.js getFlightStatusPolicy()
GDS_FLIGHT_STATUS_TIMEOUT_MS=15000
GDS_FLIGHT_STATUS_MAX_RETRIES=1
# Estimated-vs-scheduled departure gap (minutes) below which a flight is
# still reported "Scheduled", not "Delayed"
GDS_FLIGHT_STATUS_DELAY_THRESHOLD_MINUTES=15

# EXT-012 Flight Schedule (Amadeus Flight Availabilities) — utils/gdsConfig.js getFlightSchedulePolicy()
GDS_FLIGHT_SCHEDULE_TIMEOUT_MS=15000
GDS_FLIGHT_SCHEDULE_MAX_RETRIES=1
GDS_FLIGHT_SCHEDULE_CACHE_TTL_SECONDS=1800
GDS_FLIGHT_SCHEDULE_MAX_ADVANCE_DAYS=365

# EXT-015 Flight Inspiration — utils/gdsConfig.js getFlightInspirationPolicy()
GDS_FLIGHT_INSPIRATION_TIMEOUT_MS=15000
GDS_FLIGHT_INSPIRATION_MAX_RETRIES=1
GDS_FLIGHT_INSPIRATION_CACHE_TTL_SECONDS=1800
GDS_FLIGHT_INSPIRATION_MAX_RESULTS=20
GDS_FLIGHT_INSPIRATION_DEFAULT_RESULTS=10
GDS_FLIGHT_INSPIRATION_FALLBACK_CURRENCY=USD
GDS_FLIGHT_INSPIRATION_BLOCKED_DESTINATIONS_JSON=[]
GDS_FLIGHT_INSPIRATION_BOOSTED_DESTINATIONS_JSON=[]

# EXT-016 Branded Fares (Flight Offers Upselling) — utils/gdsConfig.js getBrandedFaresPolicy()
GDS_BRANDED_FARES_TIMEOUT_MS=15000
GDS_BRANDED_FARES_MAX_RETRIES=1
GDS_BRANDED_FARES_CACHE_TTL_SECONDS=600

# EXT-017 Ancillary Services — utils/gdsConfig.js getAncillaryServicesPolicy()
GDS_ANCILLARY_SERVICES_TIMEOUT_MS=15000
GDS_ANCILLARY_SERVICES_MAX_RETRIES=1
GDS_ANCILLARY_SERVICES_CACHE_TTL_SECONDS=600

# EXT-018 Flight Schedule Synchronization — utils/gdsConfig.js getFlightScheduleSyncPolicy()
FLIGHT_SCHEDULE_SYNC_CRON_SCHEDULE=*/15 * * * *
FLIGHT_SCHEDULE_SYNC_HIGH_PRIORITY_CRON_SCHEDULE=*/5 * * * *
FLIGHT_SCHEDULE_SYNC_MAX_RETRIES=5
FLIGHT_SCHEDULE_SYNC_RETRY_DELAY_MS=30000
FLIGHT_SCHEDULE_SYNC_WINDOW_DAYS_AHEAD=7
FLIGHT_SCHEDULE_SYNC_BATCH_SIZE=50
# utils/gdsConfig.js getFlightStatusPolicy() — EXT-018 addition
GDS_FLIGHT_RESCHEDULE_THRESHOLD_MINUTES=60

# EXT-019 Hotel Search (discovery) — utils/gdsConfig.js getHotelListSearchPolicy()
GDS_HOTEL_LIST_SEARCH_TIMEOUT_MS=15000
GDS_HOTEL_LIST_SEARCH_MAX_RETRIES=1
GDS_HOTEL_LIST_SEARCH_CACHE_TTL_SECONDS=900
GDS_HOTEL_LIST_SEARCH_MAX_PAGE_SIZE=100
GDS_HOTEL_LIST_SEARCH_DEFAULT_PAGE_SIZE=20

# EXT-020 Hotel Offers (room availability & pricing) — utils/gdsConfig.js getHotelOfferPolicy()
GDS_HOTEL_OFFER_TIMEOUT_MS=15000
GDS_HOTEL_OFFER_MAX_RETRIES=1
GDS_HOTEL_OFFER_CACHE_TTL_SECONDS=300
GDS_HOTEL_OFFER_MAX_ADULTS=9
GDS_HOTEL_OFFER_MAX_ROOMS=9
GDS_HOTEL_OFFER_MAX_ADVANCE_DAYS=365

# EXT-021 Hotel Offer Pricing verification — utils/gdsConfig.js getHotelPricingPolicy()
GDS_HOTEL_PRICING_TIMEOUT_MS=15000
GDS_HOTEL_PRICING_MAX_RETRIES=1
GDS_HOTEL_PRICING_CACHE_TTL_SECONDS=60

# EXT-022 Hotel Booking creation — utils/gdsConfig.js getHotelBookingPolicy()
GDS_HOTEL_BOOKING_TIMEOUT_MS=20000
GDS_HOTEL_BOOKING_MAX_RETRIES=1

# EXT-023 Hotel Booking Retrieval — utils/gdsConfig.js getHotelBookingRetrievalPolicy()
GDS_HOTEL_BOOKING_RETRIEVAL_CACHE_TTL_SECONDS=300

# EXT-013 Airport & Airline Reference Data — utils/referenceDataConfig.js getReferenceDataSyncConfig()
REFERENCE_DATA_SYNC_CRON_SCHEDULE=0 3 * * *
REFERENCE_DATA_SYNC_TIMEOUT_MS=15000
REFERENCE_DATA_SYNC_MAX_RETRIES=1
REFERENCE_DATA_CACHE_TTL_SECONDS=86400
REFERENCE_DATA_SEED_AIRPORT_CODES_JSON=["KHI","LHE","ISB","JED","MED","DXB","DOH","IST","LHR","JFK"]
REFERENCE_DATA_SEED_AIRLINE_CODES_JSON=["SV","EK","QR","TK","PK","EY","GF","TG","BA","LH"]

# EXT-014 Airport Search & Autocomplete — utils/referenceDataConfig.js getAirportSearchConfig()
AIRPORT_SEARCH_MIN_QUERY_LENGTH=2
AIRPORT_SEARCH_MAX_QUERY_LENGTH=100
AIRPORT_SEARCH_MAX_RESULTS=20
AIRPORT_SEARCH_DEFAULT_RESULTS=10
AIRPORT_SEARCH_CACHE_TTL_SECONDS=3600
AIRPORT_SEARCH_CANDIDATE_POOL_SIZE=2000

# Hotel Distribution & Booking (API-006E) — utils/gdsConfig.js getHotelSearchValidationConfig()
GDS_HOTEL_MAX_ROOMS=10
GDS_HOTEL_MAX_GUESTS=20
GDS_HOTEL_MAX_ADVANCE_BOOKING_DAYS=365

# AI Travel Assistant (API-006F) — utils/aiConfig.js. Real OpenAI/Anthropic
# SDKs (installed via npm) with a Provider-Independent adapter pattern; when
# no provider is reachable, /api/v1/ai/* honestly returns 503 rather than a
# fabricated "AI" reply. Provider selection/failover order is no longer
# AI_PRIMARY_PROVIDER/AI_SECONDARY_PROVIDER (removed) — see EXT-034's
# AI_MODEL_DEFAULT_ROUTING_ORDER_JSON further below, owned by the real
# Model Router (services/ai/AIModelRouterService.js).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_TOOL_ITERATIONS=4
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# EXT-026 §13 "Rate Limiting" — per-tool AI invocation limits, distinct from the route-level express-rate-limit on /ai/*
AI_TOOL_RATE_LIMIT_PER_USER_PER_MINUTE=20
AI_TOOL_RATE_LIMIT_PER_TENANT_PER_MINUTE=100
AI_TOOL_RATE_LIMIT_GLOBAL_PER_MINUTE=500
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_HISTORY_MESSAGES=20
AI_CONVERSATION_RETENTION_DAYS=90
# EXT-027 "Context Lifecycle" — structured session memory (selected flight/
# hotel, search params, etc.), distinct from AI_CONVERSATION_RETENTION_DAYS
# above (whole-conversation retention).
AI_MEMORY_SESSION_TIMEOUT_MINUTES=60
AI_MEMORY_EXPIRY_CRON_SCHEDULE=*/15 * * * *
# AI_PROMPT_INJECTION_PATTERNS_JSON=["ignore (all )?(previous|prior|above) instructions", ...] — see utils/aiConfig.js for the default list

# AI Tool Registry & Orchestration Engine (API-006G)
# Azure OpenAI — real, uses the same `openai` SDK with a different base URL.
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# "Cost Optimization" — estimated USD per 1,000 tokens; real billing depends
# on the provider's own invoice, these are just a configurable estimate.
# Consumed by EXT-034's Model Registry (utils/aiModelConfig.js), not aiConfig.js.
AI_COST_OPENAI_INPUT_PER_1K=0.00015
AI_COST_OPENAI_OUTPUT_PER_1K=0.0006
AI_COST_ANTHROPIC_INPUT_PER_1K=0.003
AI_COST_ANTHROPIC_OUTPUT_PER_1K=0.015
AI_COST_AZURE_INPUT_PER_1K=0.00015
AI_COST_AZURE_OUTPUT_PER_1K=0.0006
# Tool-level (not LLM-provider-level) execution policy
AI_TOOL_DEFAULT_TIMEOUT_MS=15000
AI_TOOL_DEFAULT_MAX_RETRIES=2
AI_MAX_PLAN_STEPS=8
# EXT-029 §11 "Retry Strategy — Exponential Backoff"
AI_RETRY_BASE_DELAY_MS=500
AI_RETRY_BACKOFF_MULTIPLIER=2
AI_RETRY_MAX_DELAY_MS=8000
# EXT-029 §6/§15 "Timed Out" — whole-execution wall-clock ceiling
AI_WORKFLOW_MAX_DURATION_MS=1800000

# EXT-036 §22 "Recovery" — crash-recovery sweep for AI tool executions left
# mid-flight (status "executing") by a crashed/restarted process.
AI_WORKFLOW_RECOVERY_STALE_THRESHOLD_MS=300000
AI_WORKFLOW_RECOVERY_CRON_SCHEDULE=*/5 * * * *

# EXT-029 §15 "Timeout Handling — Approval Timeout -> Reminder -> Escalation."
# Reminder/escalation notifications only — pending approvals are never
# auto-rejected in this build (confirmed product decision).
AI_APPROVAL_REMINDER_AFTER_MS=7200000
AI_APPROVAL_ESCALATION_AFTER_MS=28800000
AI_APPROVAL_TIMEOUT_CRON_SCHEDULE=*/15 * * * *

# EXT-030 "AI Knowledge & Context Retrieval (RAG Layer)". Embeddings reuse
# the same OPENAI_API_KEY / AZURE_OPENAI_* vars already configured above —
# only the model/deployment differ.
AI_EMBEDDING_PROVIDER=OpenAI
AI_EMBEDDING_MODEL=text-embedding-3-small
# Azure requires its OWN embedding-model deployment, distinct from AZURE_OPENAI_DEPLOYMENT (the chat model).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AI_KNOWLEDGE_CHUNK_SIZE_CHARS=1200
AI_KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
AI_KNOWLEDGE_MAX_CONTEXT_CHARS=6000
AI_KNOWLEDGE_DEFAULT_TOP_K=5
AI_KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
# §9 "Ranking Strategy" weights — must not need to sum to 1, each factor is
# independently weighted.
AI_KNOWLEDGE_WEIGHT_SEMANTIC=0.6
AI_KNOWLEDGE_WEIGHT_KEYWORD=0.15
AI_KNOWLEDGE_WEIGHT_TITLE=0.1
AI_KNOWLEDGE_WEIGHT_TAG=0.05
AI_KNOWLEDGE_WEIGHT_FRESHNESS=0.05
AI_KNOWLEDGE_WEIGHT_POPULARITY=0.05
# §6 "Knowledge Levels" role mapping (JSON arrays) — see utils/aiKnowledgeConfig.js for defaults.
# AI_KNOWLEDGE_OPERATIONS_ROLES_JSON=["operations","agent","coordinator","supervisor","staff"]
# AI_KNOWLEDGE_MANAGEMENT_ROLES_JSON=["manager","management","finance","compliance"]
# AI_KNOWLEDGE_EXECUTIVE_ROLES_JSON=["executive","director","ceo","board"]

# EXT-031 "AI Prompt Management & System Instructions"
# AI_PROMPT_SUPPORTED_LANGUAGES_JSON=["en","ar","ur","fr","tr"]
AI_PROMPT_DEFAULT_LANGUAGE=en
AI_PROMPT_CACHE_TTL_SECONDS=300
# §19 "Only authorized administrators may publish prompts" — distinct from
# AI_PROMPT_MANAGE_PERMISSION (create/edit drafts); admin always has both.
AI_PROMPT_PUBLISH_PERMISSION=ai.prompt.publish
AI_PROMPT_MANAGE_PERMISSION=ai.prompt.manage

# EXT-032 "AI Safety, Guardrails & Policy Enforcement"
# §14 "Risk Levels" — base score per tool riskLevel + additive signals (JSON object/number overrides).
# AI_GUARDRAIL_RISK_BASE_SCORE_JSON={"read":5,"medium":35,"high":55,"critical":80}
AI_GUARDRAIL_RISK_SCORE_INJECTION=30
AI_GUARDRAIL_RISK_SCORE_SENSITIVE_FIELD=15
# AI_GUARDRAIL_RISK_THRESHOLDS_JSON={"medium":25,"high":55,"critical":80}
# §9 "Prompt Injection Protection" — regex phrase list; a bounded heuristic, not foolproof detection.
# AI_GUARDRAIL_PROMPT_INJECTION_PATTERNS_JSON=["ignore (all )?(previous|prior|above) instructions", ...]
# §9 defense-in-depth: a flagged turn can never trigger a non-read (write-capable) tool. Set "false" to disable (not recommended).
AI_GUARDRAIL_BLOCK_NON_READ_ON_INJECTION=true
# §8 "Sensitive Data Protection" — field-name (JSON array) and value-shape (JSON array of regex) detection.
# AI_GUARDRAIL_SENSITIVE_FIELD_NAME_PATTERNS_JSON=["passport","nationalId","cnic","ssn","creditCard","bankAccount","iban","medicalInfo","visaDocument","personalNote","authToken","apiKey","secret","password"]
# AI_GUARDRAIL_SENSITIVE_VALUE_PATTERNS_JSON=["\\b\\d{4}[ -]?\\d{4}[ -]?\\d{4}[ -]?\\d{4}\\b", ...]
AI_GUARDRAIL_SYSTEM_PROMPT_LEAK_MARKER=RULES YOU MUST FOLLOW
# §19 "Only authorized administrators may manage policies" — admin always has this too.
AI_GUARDRAIL_MANAGE_PERMISSION=ai.guardrail.manage

# EXT-033 "AI Observability, Monitoring & Evaluation"
# §15 "Error Categories" (JSON object: category -> regex pattern, first match wins).
# AI_OBSERVABILITY_ERROR_CATEGORY_PATTERNS_JSON={"policy_violation":"blocked by ai safety policy", ...}
# §22 "AI Health Score" — weights (JSON object, should sum to 1.0) and latency scoring band.
# AI_OBSERVABILITY_HEALTH_WEIGHTS_JSON={"availability":0.2,"latency":0.15,"failures":0.2,"safety":0.15,"quality":0.15,"toolSuccess":0.15}
AI_OBSERVABILITY_LATENCY_GOOD_MS=3000
AI_OBSERVABILITY_LATENCY_POOR_MS=15000
# §19 "Alerting" thresholds (JSON object) — see utils/aiObservabilityConfig.js for defaults.
# AI_OBSERVABILITY_ALERT_THRESHOLDS_JSON={"failureRatePct":25,"highLatencyMs":10000,"hallucinationRatePct":15,"toolFailureRatePct":30,"dailyCostUsd":25,"guardrailBlockRatePct":20,"providerUnavailable":true}
AI_OBSERVABILITY_ALERT_WINDOW_MS=3600000
AI_OBSERVABILITY_ALERT_MIN_SAMPLE=5
AI_OBSERVABILITY_ALERT_CRON_SCHEDULE=*/10 * * * *
AI_OBSERVABILITY_DEFAULT_LOOKBACK_MS=86400000
# §19 "Only authorized administrators may manage observability" — admin always has this too.
AI_OBSERVABILITY_MANAGE_PERMISSION=ai.observability.manage

# EXT-034 "AI Model Management & Multi-LLM Routing" — utils/aiModelConfig.js.
# Real Model Registry: OpenAI/Anthropic/AzureOpenAI reuse their existing keys
# above; every provider below is a genuine, documented OpenAI-compatible
# chat-completions API, served by the ONE generic OpenAICompatibleAdapter —
# leave any of these unset to leave that provider disabled (never fabricated
# as available). Google Gemini is deliberately NOT included — it needs a
# separate, non-OpenAI-compatible SDK and stays "(Future)" per every earlier
# EXT document in this AI module.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_COST_DEEPSEEK_INPUT_PER_1K=0.00014
AI_COST_DEEPSEEK_OUTPUT_PER_1K=0.00028
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
AI_COST_QWEN_INPUT_PER_1K=0.0004
AI_COST_QWEN_OUTPUT_PER_1K=0.0012
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
AI_COST_MISTRAL_INPUT_PER_1K=0.0002
AI_COST_MISTRAL_OUTPUT_PER_1K=0.0006
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
AI_COST_OPENROUTER_INPUT_PER_1K=0.0005
AI_COST_OPENROUTER_OUTPUT_PER_1K=0.0015
# Self-hosted/local (§5 "Local Llama, Ollama") — no real API key required by
# Ollama itself; OLLAMA_BASE_URL being set is what enables this provider.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3
# OLLAMA_API_KEY=
# §13 "Tool Calling" — deliberately false by default for every provider
# above (reliability varies a lot across models served this way); set to
# "true" only for a specific provider you've verified genuinely supports
# function calling through its OpenAI-compatible endpoint.
# AI_MODEL_DEEPSEEK_TOOL_CALLING=false
# AI_MODEL_QWEN_TOOL_CALLING=false
# AI_MODEL_MISTRAL_TOOL_CALLING=false
# AI_MODEL_OPENROUTER_TOOL_CALLING=false
# AI_MODEL_OLLAMA_TOOL_CALLING=false
# §8 "Provider Ranking" — default failover order; a per-tenant
# AIRoutingPolicyModel row (via POST /api/v1/ai/models/routing-policies)
# overrides this for one category without touching this global default.
# AI_MODEL_DEFAULT_ROUTING_ORDER_JSON=["OpenAI","Anthropic","AzureOpenAI","DeepSeek","Qwen","Mistral","OpenRouter","Ollama"]
# §19 "Only authorized administrators may manage routing/A-B tests" — admin always has this too.
AI_MODEL_MANAGE_PERMISSION=ai.model.manage

# EXT-035 "AI Agent Framework & Multi-Agent Orchestration"
# §21 "Only authorized administrators may transition agent lifecycle" — admin always has this too.
AI_AGENT_MANAGE_PERMISSION=ai.agent.manage

# Event delivery (the current runtime persists a durable MongoDB event log and
# dispatches in-process; configure a broker adapter before horizontal scaling).
EVENT_BUS_TRANSPORT=memory
EVENT_OUTBOX_ENABLED=true
