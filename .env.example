# Database
URI=mongodb://127.0.0.1:27017/maqvera
PRIVATE_KEY=replace-with-a-long-random-secret

# Identity & Authentication (Login / MFA / sessions — docs/05-api/03-auth-api.md)
# Critical: startup fails (config/envValidator.js) if these are missing or left insecure.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Access/refresh token lifetimes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_DAYS=30
# Used only when the login request sets rememberMe=true
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_IN=90d
REFRESH_TOKEN_REMEMBER_ME_EXPIRES_DAYS=90
# Login lockout policy
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Require an active tenant/role for every login (see Login business rules)
STRICT_AUTH_DOMAIN=false
# Optional. Only set this for a genuinely single-tenant on-prem deployment:
# lets POST /auth/signup omit tenantKey and join this tenant implicitly.
# Leave unset for normal multi-tenant/SaaS use — signup then requires an
# explicit tenantKey, and new companies register via POST /auth/setup.
# DEFAULT_TENANT_KEY=
# Auth endpoint rate limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=100
# MFA challenge lifetimes
MFA_CODE_TTL_MINUTES=10
MFA_TOKEN_TTL_MINUTES=10
# GET /auth/me is called on every page load/refresh; audit it only if you need that trail
ME_ENDPOINT_AUDIT_ENABLED=false
# Whether POST /auth/change-password revokes the user's other active sessions
CHANGE_PASSWORD_REVOKE_OTHER_SESSIONS=true
# Minimum seconds between reset-token issuances for the same user (abuse/email-bombing guard)
FORGOT_PASSWORD_COOLDOWN_SECONDS=60
# GET /auth/sessions is a routine "view my devices" call; audit it only if you need that trail
SESSIONS_LIST_AUDIT_ENABLED=false
# Minimum seconds between invitation resends for the same employee (abuse/email-bombing guard)
RESEND_INVITATION_COOLDOWN_SECONDS=60
# Offline IP-to-country/city lookup (geoip-lite) used for session/login-history location fields.
# No API key needed; set to false to disable resolution entirely (e.g. privacy/compliance).
SESSION_GEO_LOCATION_ENABLED=true
# SMTP — required for email-based MFA codes, verification, and reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=MAQVERA
EMAIL_FROM=

# Passport identifiers (optional format overrides)
PASSPORT_DISPATCH_PREFIX=DISP
PASSPORT_RECEIPT_PREFIX=RCP
INCIDENT_NUMBER_PREFIX=INC
VISA_CASE_NUMBER_PREFIX=VIS
INCIDENT_DEFAULT_ASSIGNMENT_TEAM=Operations
TIMELINE_MAX_NOTE_LENGTH=5000

# Courier provider integration. Leave both unset to retain manual tracking.
COURIER_API_BASE_URL=https://courier-provider.example/api
COURIER_API_KEY=replace-with-courier-api-key

# Redis Cache (optional — falls back to in-memory if unset)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=maqvera:

# Document storage. Use one configured backend; secrets remain only in .env.
FILE_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_STORAGE_BASE_URL=
DOCUMENT_SIGNING_SECRET=replace-with-a-long-random-secret
# JSON array overrides — leave unset to use the built-in defaults
DOCUMENT_ALLOWED_MIME_TYPES_JSON=
SUPPORTED_DOCUMENT_TYPES_JSON=
# S3_ENDPOINT above also covers any S3-compatible provider (e.g. Cloudflare
# R2, MinIO) — set FILE_STORAGE_BACKEND=s3 and point S3_ENDPOINT at it.
# Document retention (days an archived document's metadata is kept before
# being eligible for a manual/future purge pass — no automated deletion runs)
DOCUMENT_RETENTION_DAYS=2555
# Document expiry check + reminder scheduler
DOCUMENT_EXPIRY_CRON_SCHEDULE=0 3 * * *
DOCUMENT_EXPIRY_REMINDER_DAYS=30
# Appointment reminder + missed-appointment sweep
APPOINTMENT_REMINDER_CRON_SCHEDULE=*/15 * * * *
# Cloudinary (required only when FILE_STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maqvera-documents
# S3-compatible object storage (required only when FILE_STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FOLDER=maqvera-documents

# utils/fileStorage.js — a separate, general-purpose object-storage helper
# (saveBookingDocumentFile) reused by incident attachments and, as of
# EXT-010, boarding pass storage. Pre-existing but previously undocumented;
# documented now since EXT-010 depends on it. Distinct env-var names from
# the FILE_STORAGE_BACKEND/S3_* block above (that one backs
# services/FileUploadService.js / EnterpriseDocumentService).
BOOKING_DOCUMENT_STORAGE_PROVIDER=local
BOOKING_DOCUMENT_STORAGE_PATH=
BOOKING_DOCUMENT_PUBLIC_BASE_URL=http://localhost:5000/uploads/booking-documents
# Required only when BOOKING_DOCUMENT_STORAGE_PROVIDER=s3 (uses the AWS SDK directly)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# EXT-010 — Airline Flight Check-in. No airline exposes a public,
# installable check-in SDK the way Amadeus does for search/pricing/booking;
# a real per-airline integration requires that airline's own commercial API
# credentials, configured per code below. Every airline is honestly
# "unsupported" (falls back to their real web check-in portal) until
# configured — utils/airlineCheckInConfig.js.
AIRLINE_CHECKIN_TIMEOUT_MS=15000
# Optional override of the built-in airline name/redirect-URL registry
# AIRLINE_CHECKIN_REGISTRY_JSON={"EK":{"airlineName":"Emirates","checkInUrl":"https://www.emirates.com"}}
# Per-airline real API credentials (example shape — replace CODE with the real IATA airline code, e.g. EK, QR, TK, SV, PK)
# AIRLINE_CHECKIN_EK_BASE_URL=
# AIRLINE_CHECKIN_EK_API_KEY=

# Dashboard & Analytics
DASHBOARD_CACHE_TTL_SECONDS=60
# How many trailing days GET /bookings/dashboard's "Booking Trends" series covers
BOOKING_DASHBOARD_TREND_DAYS=14
ANALYTICS_CRON_SCHEDULE=*/5 * * * *
ANALYTICS_NIGHTLY_CRON_SCHEDULE=0 2 * * *
# Max span allowed for GET /dashboard/trends?dateFrom=&dateTo= (Custom Date Range)
DASHBOARD_TREND_MAX_RANGE_DAYS=366

# Enterprise Search (MongoDB read-model backend)
ENTERPRISE_SEARCH_MAX_PAGE_SIZE=100
# Redis-backed cache TTL for GET /search result pages (via CacheManager)
SEARCH_CACHE_TTL_SECONDS=30
# Fuzzy fallback (Levenshtein): max edit distance considered a match, and how
# many recent index rows to scan as candidates when the exact pass finds none
SEARCH_FUZZY_MAX_DISTANCE=2
SEARCH_FUZZY_CANDIDATE_LIMIT=500

# Retry policy for transient external-service calls (object storage uploads)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300

# Idempotency-Key support (opt-in, via the Idempotency-Key request header)
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Customer Management (utils/customerConfig.js)
CUSTOMER_CODE_PREFIX=CUS
DEFAULT_CUSTOMER_CATEGORY=regular
DEFAULT_CUSTOMER_STATUS=active
DEFAULT_CUSTOMER_LANGUAGE=en
DEFAULT_CUSTOMER_CURRENCY=USD
DEFAULT_CUSTOMER_TIMEZONE=UTC
CUSTOMER_ENABLE_DUPLICATE_DETECTION=true
# Minimum duplicate-detection score (0-100, see the Customer Duplicate
# Detection score table) required to block customer creation with a 409.
CUSTOMER_DUPLICATE_SCORE_THRESHOLD=85
CUSTOMER_DEFAULT_PAGE_SIZE=20
CUSTOMER_MAX_PAGE_SIZE=100
CUSTOMER_ENABLE_VERSIONING=true
CUSTOMER_ENABLE_TIMELINE=true
DEFAULT_CUSTOMER_COMMUNICATION_CHANNEL=whatsapp
DEFAULT_CUSTOMER_DOCUMENT_STATUS=pending_scan
DEFAULT_CUSTOMER_DOCUMENT_VISIBILITY=internal
DEFAULT_CUSTOMER_DOCUMENT_CATEGORY=Identity
DEFAULT_CUSTOMER_NOTE_CATEGORY=General
DEFAULT_CUSTOMER_NOTE_VISIBILITY=Internal
CUSTOMER_ALLOWED_NOTE_CATEGORIES=Customer Service,Sales,Finance,Visa,Travel,Medical,Operations,Support,General
CUSTOMER_ALLOWED_NOTE_VISIBILITIES=Internal,Management,Branch,Private
DEFAULT_CUSTOMER_MEAL_PREFERENCE=halal
DEFAULT_CUSTOMER_SEAT_PREFERENCE=no_preference
DEFAULT_CUSTOMER_NOTIFICATION_PREFERENCES={"email":true,"sms":true,"whatsapp":true,"push":false}
# Falls back to FILE_STORAGE_BACKEND/FILE_STORAGE_PROVIDER above if unset.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PROVIDER=Local
CUSTOMER_ALLOWED_FAMILY_RELATIONSHIPS=father,mother,husband,wife,spouse,son,daughter,brother,sister,guardian,mahram,friend,other
CUSTOMER_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/heic,image/tiff,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# How long a customer document's signed download URL stays valid (see
# DOCUMENT_SIGNING_SECRET/DOCUMENT_STORAGE_BASE_URL above, which generate it).
CUSTOMER_DOCUMENT_SIGNED_URL_TTL_SECONDS=900

# Booking Management (utils/bookingConfig.js)
DEFAULT_CURRENCY=USD
DEFAULT_BOOKING_TYPE=umrah
DEFAULT_BOOKING_STATUS=draft
DEFAULT_BOOKING_PRIORITY=normal
DEFAULT_PAYMENT_STATUS=unpaid
DEFAULT_VISA_STATUS=pending
DEFAULT_TRAVELER_TYPE=adult
DEFAULT_TRAVELER_STATUS=registered
DEFAULT_SERVICE_WORKFLOW_STATUS=created
DEFAULT_SERVICE_STATUS=active
DEFAULT_BOOKING_DOCUMENT_STATUS=pending_scan
DEFAULT_SERVICE_PRIORITY=normal
AUTO_CREATE_BOOKING_WORKFLOW=true
DEFAULT_BOOKING_PAGE_SIZE=20
MAX_BOOKING_PAGE_SIZE=100
# Advanced overrides — each is a JSON array; see utils/bookingConfig.js for the
# default shape (booking types/statuses/service types/workflow states &
# transitions). Leave unset to use the built-in defaults, which already cover
# the full Booking Lifecycle (Part 1) including partially_paid/refunded/rejected.
# BOOKING_TYPES_JSON=
# BOOKING_STATUSES_JSON=
# BOOKING_PAYMENT_STATUSES_JSON=
# BOOKING_VISA_STATUSES_JSON=
# BOOKING_TRAVELER_TYPES_JSON=
# BOOKING_TRAVELER_STATUSES_JSON=
# BOOKING_WORKFLOW_DEFINITIONS_JSON=
# BOOKING_WORKFLOW_STATES_JSON=
# BOOKING_SERVICE_TYPES_JSON=
# BOOKING_SERVICE_CATEGORIES_JSON=
# BOOKING_SERVICE_WORKFLOW_STATUSES_JSON=
# SUPPORTED_CURRENCIES_JSON=

# Finance / Chart of Accounts (utils/financeConfig.js) — currency support is
# shared with Booking's SUPPORTED_CURRENCIES_JSON/DEFAULT_CURRENCY above, not
# duplicated here.
DEFAULT_ACCOUNT_STATUS=Active
DEFAULT_ACCOUNT_TYPE=Posting
DEFAULT_ACCOUNT_PAGE_SIZE=20
MAX_ACCOUNT_PAGE_SIZE=100
MAX_ACCOUNT_HIERARCHY_DEPTH=10
# Advanced overrides — each is a JSON array; see utils/financeConfig.js for
# the default shape. Leave unset to use the built-in defaults.
# ACCOUNT_CATEGORIES_JSON=
# ACCOUNT_TYPES_JSON=
# ACCOUNT_STATUSES_JSON=

# General Journal (utils/financeConfig.js)
DEFAULT_JOURNAL_STATUS=Draft
DEFAULT_JOURNAL_TYPE=Manual
JOURNAL_NUMBER_PREFIX=JV
JOURNAL_APPROVAL_REQUIRED=true
# JOURNAL_TYPES_JSON=
# JOURNAL_STATUSES_JSON=

# Financial Periods — shared by Journal + General Ledger posting validation
# FINANCIAL_PERIOD_TYPES_JSON=
# FINANCIAL_PERIOD_STATUSES_JSON=

# General Ledger (utils/financeConfig.js)
ACCOUNT_BALANCE_CACHE_TTL_SECONDS=30
TRIAL_BALANCE_CACHE_TTL_SECONDS=30
DEFAULT_LEDGER_PAGE_SIZE=50
MAX_LEDGER_PAGE_SIZE=200

# Accounts Receivable (utils/financeConfig.js)
DEFAULT_RECEIVABLE_STATUS=Open
AR_OVERDUE_CRON_SCHEDULE=0 4 * * *
AR_CREDIT_LIMIT_ENFORCEMENT=true
# RECEIVABLE_STATUSES_JSON=
# AR_AGING_BUCKETS_JSON=
# AR_COLLECTION_STAGES_JSON=
# Chart of Accounts codes (Part 2) used to auto-post AR/Payment/Write-off
# journals — leave unset to skip ledger posting for that operation until
# configured, rather than guessing which of a tenant's accounts to use.
# AR_CONTROL_ACCOUNT_CODE=
# BAD_DEBT_EXPENSE_ACCOUNT_CODE=
# DEFAULT_CASH_ACCOUNT_CODE=
# CUSTOMER_CREDIT_LIABILITY_ACCOUNT_CODE=

# Enterprise Payment Engine (utils/financeConfig.js) — Finance Module Part 7.
# See controllers/PaymentController.js. Consolidates what were previously
# separate customer/vendor payment records into one engine AR/AP both call.
# PAYMENT_TYPES_JSON=
# PAYMENT_METHODS_JSON=
# PAYMENT_GATEWAYS_JSON=
DEFAULT_PAYMENT_GATEWAY=Manual
# PAYMENT_STATUSES_JSON=
PAYMENT_NUMBER_PREFIX=PAY
# PAYMENT_ALLOCATION_TARGET_TYPES_JSON=
# Rule-based (non-AI) fraud detection thresholds.
FRAUD_DUPLICATE_WINDOW_MINUTES=5
FRAUD_VELOCITY_WINDOW_MINUTES=60
FRAUD_VELOCITY_MAX_COUNT=5
FRAUD_AMOUNT_THRESHOLD=1000000
# Real Stripe integration (services/gateways/StripeGatewayAdapter.js) — the
# `stripe` npm package genuinely calls the Stripe API when this is set;
# every gateway method throws a clear error (never a fake success) when
# unset. Every other listed gateway (PayPal/Square/AuthorizeNet/Adyen/
# Razorpay/Custom) has no adapter implemented yet — see the doc's Part 7
# Deferred section.
# STRIPE_SECRET_KEY=

# Accounts Payable (utils/financeConfig.js) — reuses AR_AGING_BUCKETS_JSON
# for Vendor Aging (one bucket definition for the whole ERP).
DEFAULT_PAYABLE_STATUS=Draft
# PAYABLE_STATUSES_JSON=
# AP_PAYMENT_PRIORITIES_JSON=
# Chart of Accounts codes used to auto-post AP/write-off journals — leave
# unset to skip ledger posting until configured (same fallback as the AR
# account codes above). Cash side reuses DEFAULT_CASH_ACCOUNT_CODE.
# AP_CONTROL_ACCOUNT_CODE=
# VENDOR_WAIVER_INCOME_ACCOUNT_CODE=
# VENDOR_ADVANCE_ASSET_ACCOUNT_CODE=

# Enterprise Receipts (utils/financeConfig.js) — Finance Module Part 8.
DEFAULT_RECEIPT_STATUS=Generated
DEFAULT_RECEIPT_TEMPLATE=Default
RECEIPT_NUMBER_PREFIX=RCT
RECEIPT_ALLOW_MULTIPLE_PER_PAYMENT=false
# RECEIPT_STATUSES_JSON=
# RECEIPT_TEMPLATES_JSON=
# RECEIPT_DELIVERY_METHODS_JSON=
# RECEIPT_ELIGIBLE_PAYMENT_STATUSES_JSON=
# Base URL the QR code / PDF download links point at. Falls back to
# FRONTEND_URL, then a local dev URL — set this explicitly in production so
# generated receipt links are actually reachable by whoever gets them.
# RECEIPT_VERIFICATION_BASE_URL=
# Real WhatsApp/SMS delivery (services/delivery/) via Twilio — the `twilio`
# npm package genuinely calls the Twilio API when these are set; every
# delivery attempt is honestly recorded as "NotConfigured" (never a fake
# success) when they're not.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# TWILIO_SMS_FROM=

# Enterprise Invoices (utils/financeConfig.js) — Finance Module Part 9.
DEFAULT_INVOICE_TYPE=Commercial
DEFAULT_INVOICE_STATUS=Draft
INVOICE_APPROVAL_REQUIRED=true
INVOICE_NUMBER_PREFIX=INV
# INVOICE_TYPES_JSON=
# INVOICE_STATUSES_JSON=
# TAX_CODES_JSON moved to the Finance Module Part 20 (Tax Engine) section
# below — it now serves as that engine's own last-resort fallback.
# Fallback revenue account for the auto-generated AR journal when an
# invoice doesn't specify its own — leave unset to skip that ledger posting
# until configured (same fallback as every other optional account code).
# DEFAULT_REVENUE_ACCOUNT_CODE=

# Enterprise Credit Notes (utils/financeConfig.js) — Finance Module Part 10.
# CREDIT_NOTE_REASONS_JSON=["Product Return","Service Cancellation","Pricing Correction","Tax Correction","Billing Error","Customer Goodwill","Other"]
# CREDIT_NOTE_STATUSES_JSON=["Draft","Pending Approval","Approved","Issued","Allocated","Closed","Cancelled","Voided"]
DEFAULT_CREDIT_NOTE_STATUS=Draft
CREDIT_NOTE_APPROVAL_REQUIRED=true
CREDIT_NOTE_NUMBER_PREFIX=CN
# "CustomerCredit" (safe default, always works) or "Refund" (also fires
# RefundRequested for finance-ops/a future Refund Management module to act
# on — no automatic bank refund is executed by this module).
DEFAULT_CREDIT_NOTE_DISPOSITION=CustomerCredit

# Enterprise Debit Notes (utils/financeConfig.js) — Finance Module Part 11.
# CREDIT_NOTE_REASONS_JSON's mirror — same JSON-array-override pattern.
# DEBIT_NOTE_REASONS_JSON=["Additional Charges","Price Correction","Underbilling Adjustment","Late Fee","Returned Cheque Charge","Tax Adjustment","Shipping Correction","Contractual Penalty","Other"]
# DEBIT_NOTE_STATUSES_JSON=["Draft","Pending Approval","Approved","Issued","Allocated","Closed","Cancelled","Voided"]
DEFAULT_DEBIT_NOTE_STATUS=Draft
DEBIT_NOTE_APPROVAL_REQUIRED=true
DEBIT_NOTE_NUMBER_PREFIX=DBN

# Enterprise Refund Management (utils/financeConfig.js) — Finance Module Part 12.
# REFUND_STATUSES_JSON=["Requested","Under Review","Approved","Processing","Completed","Rejected","Cancelled","Failed"]
DEFAULT_REFUND_STATUS=Requested
REFUND_APPROVAL_REQUIRED=true
# 0 = no threshold-forced approval (the boolean gate above still applies).
REFUND_APPROVAL_AMOUNT_THRESHOLD=0
REFUND_NUMBER_PREFIX=REF
# REFUND_METHODS_JSON=["Original Gateway","Bank Transfer","Cash","Cheque","Customer Wallet","Store Credit","Custom Method"]
DEFAULT_REFUND_METHOD=Original Gateway
# 0 = unlimited.
REFUND_WINDOW_DAYS=90

# Chargebacks (utils/financeConfig.js) — grouped under Refund Management,
# Finance Module Part 12.
# CHARGEBACK_STATUSES_JSON=["Open","Evidence Submitted","Under Appeal","Won","Lost"]
DEFAULT_CHARGEBACK_STATUS=Open
CHARGEBACK_NUMBER_PREFIX=CB
# CHARGEBACK_LOSS_EXPENSE_ACCOUNT_CODE=6100

# Enterprise Bank Accounts (utils/financeConfig.js) — Finance Module Part 13.
# AES-256-GCM key for encrypting bank account numbers at rest
# (utils/fieldEncryption.js). Falls back to MFA_ENCRYPTION_KEY (already
# mandatory) when unset — set a dedicated key here for real deployments.
# BANK_ACCOUNT_ENCRYPTION_KEY=
# BANK_ACCOUNT_TYPES_JSON=["Operating","Savings","Settlement","Payroll","Escrow","Petty Cash","Treasury","Virtual Account","Custom"]
# BANK_ACCOUNT_STATUSES_JSON=["Pending Verification","Verified","Active","Frozen","Suspended","Closed","Archived"]
DEFAULT_BANK_ACCOUNT_STATUS=Pending Verification
BANK_ACCOUNT_APPROVAL_REQUIRED=true
BANK_ACCOUNT_CODE_PREFIX=BA
# BANK_ADJUSTMENT_SUSPENSE_ACCOUNT_CODE=6200

# Enterprise Bank Reconciliation (utils/financeConfig.js) — Finance Module Part 14.
# RECONCILIATION_STATUSES_JSON=["Manual Review","Approved","Completed","Rejected","Archived"]
DEFAULT_RECONCILIATION_STATUS=Manual Review
RECONCILIATION_APPROVAL_REQUIRED=true
RECONCILIATION_NUMBER_PREFIX=REC
# RECONCILIATION_IMPORT_FORMATS_JSON=["CSV","Excel","MT940","CAMT.053","OFX","Custom"]
RECONCILIATION_IMPORT_MAX_FILE_SIZE_BYTES=10485760
RECONCILIATION_DATE_TOLERANCE_DAYS=3
RECONCILIATION_LOOKBACK_DAYS=7
RECONCILIATION_AMOUNT_TOLERANCE=1
# Must sum to 1 — normalized automatically if it doesn't.
RECONCILIATION_MATCH_WEIGHTS_JSON={"amount":0.5,"date":0.3,"reference":0.2}
RECONCILIATION_AUTO_MATCH_THRESHOLD=85
# AI Matching reuses this codebase's existing multi-provider AI Model
# Router (utils/aiModelConfig.js / services/ai/AIModelRouterService.js) —
# no separate AI credentials needed here; configure ANTHROPIC_API_KEY /
# OPENAI_API_KEY / etc. as already documented elsewhere in this file.

# Enterprise Cash Management (utils/financeConfig.js) — Finance Module Part 15.
# "Cash != Bank" — a deliberately separate model family from Part 13's Bank
# Accounts; see utils/financeConfig.js's own doc comment.
# CASH_LOCATION_TYPES_JSON=["Cash Drawer","Petty Cash","Cash Counter","Safe","Vault","POS Till","Custom"]
# CASH_LOCATION_STATUSES_JSON=["Opened","Closed","Archived"]
DEFAULT_CASH_LOCATION_STATUS=Opened
CASH_LOCATION_CODE_PREFIX=CSH
# CASH_TRANSFER_STATUSES_JSON=["Pending Approval","Approved","Completed","Rejected","Cancelled"]
DEFAULT_CASH_TRANSFER_STATUS=Pending Approval
CASH_TRANSFER_APPROVAL_REQUIRED=true
CASH_TRANSFER_NUMBER_PREFIX=CTR
# CASH_COUNT_TYPES_JSON=["Scheduled","Surprise","Daily Closing","Weekly","Monthly","Manual"]
CASH_COUNT_NUMBER_PREFIX=CNT
# 0 = exact match required to be "Balanced".
CASH_COUNT_VARIANCE_TOLERANCE=0
PETTY_CASH_ADVANCE_NUMBER_PREFIX=PCA
# CASH_SHORTAGE_EXPENSE_ACCOUNT_CODE=6300
# CASH_OVERAGE_INCOME_ACCOUNT_CODE=4300
# Petty cash "Replenishment" reuses BANK_ADJUSTMENT_SUSPENSE_ACCOUNT_CODE
# (Part 13, above) as its funding-source counter-account — no separate var.
# Cash Forecasting reuses the same AI Model Router as Bank Reconciliation's
# AI Matching (Part 14) — no separate AI credentials needed here either.

# Enterprise Expense Management (utils/financeConfig.js) — Finance Module Part 16.
# "The expense is not the payment. The reimbursement is the financial event."
# EXPENSE_CATEGORIES_JSON=["Travel","Visa","Meals","Accommodation","Fuel","Office Supplies","Marketing","Training","Utilities","IT Equipment","Custom"]
# EXPENSE_STATUSES_JSON=["Draft","Submitted","Under Review","Approved","Rejected","Cancelled","Returned","Reimbursed","Closed"]
DEFAULT_EXPENSE_STATUS=Draft
EXPENSE_NUMBER_PREFIX=EXP
# EXPENSE_PAYMENT_METHODS_JSON=["Personal Cash","Personal Card","Corporate Card","Corporate Debit Card","Fuel Card","Virtual Card"]
# "Payroll"/"Wallet Credit" excluded — no Payroll module or employee-wallet
# concept exists anywhere in this codebase.
# EXPENSE_REIMBURSEMENT_METHODS_JSON=["Bank Transfer","Cash","Petty Cash","Accounts Payable"]
# Amount-based multi-level approval — Manager is always required; these add
# Finance/CFO once the amount reaches them (0 = that tier never required).
EXPENSE_APPROVAL_THRESHOLD_FINANCE=500
EXPENSE_APPROVAL_THRESHOLD_CFO=5000
EXPENSE_RECEIPT_REQUIRED_ABOVE_AMOUNT=25
# EXPENSE_MAX_AMOUNT_PER_CATEGORY_JSON={}
# Block hard-stops submission over budget; Warn allows it through but
# flags budgetExceeded and fires BudgetExceeded.
EXPENSE_BUDGET_ENFORCEMENT=Warn
# EXPENSE_PER_DIEM_RATES_JSON={"Default":50}
# EXPENSE_MILEAGE_RATES_JSON={"Car":0.5,"Motorcycle":0.25,"Bicycle":0.1}
EXPENSE_MILEAGE_DISTANCE_UNIT=km
EXPENSE_RECEIPT_MAX_FILE_SIZE_BYTES=10485760
# Real OCR (tesseract.js for images, pdf-parse for text-based PDFs) — no
# external API key needed. Disable if OCR's CPU cost isn't wanted.
EXPENSE_OCR_ENABLED=true
# EXPENSE_REIMBURSEMENT_EXPENSE_ACCOUNT_CODE=6400

# Enterprise Vendor Payments (utils/financeConfig.js) — Finance Module Part 17.
# "Payment Engine moves money. Vendor Payment Platform decides which
# vendor, which invoices, which bank account, which date, which approval,
# which payment file."
# VENDOR_PAYMENT_STATUSES_JSON=["Proposed","Approved","Scheduled","Executing","Completed","Rejected","Cancelled","Failed","On Hold"]
DEFAULT_VENDOR_PAYMENT_STATUS=Proposed
VENDOR_PAYMENT_NUMBER_PREFIX=VPY
VENDOR_PAYMENT_APPROVAL_REQUIRED=true
# 0 = dual (two-person) approval never required beyond the single default gate.
VENDOR_PAYMENT_DUAL_APPROVAL_THRESHOLD=0
# PAYMENT_BATCH_TYPES_JSON=["Daily","Weekly","Monthly","Urgent","Custom"]
PAYMENT_BATCH_NUMBER_PREFIX=BATCH
# Real generators for all five (services/paymentFileGenerators/) — "SEPA"
# and "ISO 20022" share the same real pain.001 generator.
# PAYMENT_FILE_FORMATS_JSON=["CSV","ACH","SEPA","ISO 20022","SWIFT MT"]
# Real Sat/Sun rolling; "Holiday Rules" is honestly not implemented — no
# holiday-calendar data exists anywhere in this codebase.
VENDOR_PAYMENT_BUSINESS_DAY_SKIP_WEEKENDS=true
# Payment timing recommendations reuse the same AI Model Router as Cash
# Forecasting (Part 15) and Bank Reconciliation AI Matching (Part 14) — no
# separate AI credentials needed here either.

# Enterprise Customer Payments (utils/financeConfig.js) — Finance Module
# Part 18. "The Customer Collection Platform manages the collection
# strategy. The Payment Engine performs the actual payment."
# CUSTOMER_COLLECTION_STATUSES_JSON=["Requested","Partially Collected","Collected","Overdue","Payment Failed","Disputed","Written Off","Cancelled","Closed"]
DEFAULT_CUSTOMER_COLLECTION_STATUS=Requested
CUSTOMER_COLLECTION_NUMBER_PREFIX=COL
# INSTALLMENT_FREQUENCIES_JSON=["Weekly","Monthly","Quarterly","Custom"]
# Advance deposits reuse CustomerCreditService.createCredit (Part 10) —
# source is free-text against CustomerCredit, this list only constrains
# what a caller may request.
# CUSTOMER_DEPOSIT_SOURCE_TYPES_JSON=["Booking Deposit","Visa Deposit","Project Deposit","Subscription Deposit"]
# Real token + QR reuse of services/ReceiptQrService.js (Part 8) — no
# separate base URL; RECEIPT_VERIFICATION_BASE_URL below is shared.
PAYMENT_LINK_EXPIRY_HOURS=168
# Drives services/customerCollectionScheduler.js's own overdue pass — a
# collection has its own paymentDueDate, independent of AR's own
# AR_OVERDUE_CRON_SCHEDULE. Real dunning delivery (services/delivery/) is
# also wired as a new NotificationRequested listener in
# CustomerCollectionService — no separate cron/env var needed for that; it
# fires off AR's own existing collectionStages escalation in real time.
CUSTOMER_COLLECTION_OVERDUE_CRON_SCHEDULE="0 9 * * *"
# "Late Fee" — 0 disables it entirely (default). A tenant that sets a
# nonzero percent also opts into it firing once per collection, at
# CUSTOMER_COLLECTION_LATE_FEE_STAGE (an AR collectionStages stage name).
CUSTOMER_COLLECTION_LATE_FEE_PERCENT=0
CUSTOMER_COLLECTION_LATE_FEE_STAGE="Collection Team"
# Cash flow forecast reuses the same AI Model Router as Cash Forecasting
# (Part 15) and Vendor Payment timing (Part 17) — no separate AI
# credentials needed here either.

# Enterprise Multi-Currency & Foreign Exchange (utils/financeConfig.js) —
# Finance Module Part 19. "One business transaction can involve multiple
# currencies simultaneously. The ERP must preserve all of them correctly
# for accounting and reporting."
# CURRENCY_STATUSES_JSON=["Draft","Active","Suspended","Archived"]
DEFAULT_CURRENCY_STATUS=Draft
CURRENCY_APPROVAL_REQUIRED=false
# EXCHANGE_RATE_TYPES_JSON=["Spot","Historical","Average","MonthEnd","Custom"]
DEFAULT_EXCHANGE_RATE_TYPE=Spot
# RATE_PROVIDERS_JSON=["CentralBank","CommercialBank","OpenExchangeAPI","Manual","Custom"]
DEFAULT_RATE_PROVIDER=Manual
# Real HTTP integration (services/CurrencyService.js importRatesFromProvider,
# Node's own global fetch) against openexchangerates.org — leave unset to
# keep automatic rate import honestly "not configured" (manual rate entry
# still works fully without it).
OPEN_EXCHANGE_RATES_APP_ID=
OPEN_EXCHANGE_RATES_BASE_URL=https://openexchangerates.org/api
# FX_REVALUATION_TARGETS_JSON=["BankAccount","AccountsReceivable","AccountsPayable"]
# Monthly, 1st of the month at 01:00 — real period-end revaluation
# (services/currencyRevaluationScheduler.js), only runs for tenants that
# have actually configured a second (non-base) Active currency.
FX_REVALUATION_CRON_SCHEDULE="0 1 1 * *"
# Both must be set for FX gain/loss journal postings to happen at all —
# same "skip ledger posting until configured" fallback as every other
# optional account-code pair in this module.
FX_GAIN_ACCOUNT_CODE=
FX_LOSS_ACCOUNT_CODE=

# Enterprise Tax Engine (utils/financeConfig.js) — Finance Module Part 20.
# "A real ERP never hardcodes tax logic. It uses a centralized Tax
# Engine." Replaces Invoice/Credit Note/Debit Note's own static
# TAX_CODES_JSON lookup (still set below as the last-resort fallback)
# with a real, versioned, country-aware TaxRuleModel.
# TAX_RULE_STATUSES_JSON=["Draft","Approved","Expired","Archived","Superseded"]
DEFAULT_TAX_RULE_STATUS=Draft
TAX_RULE_APPROVAL_REQUIRED=true
# TAX_TYPES_JSON=["VAT","GST","SalesTax","ServiceTax","WithholdingTax","ImportTax","ExportTax","LuxuryTax","EnvironmentalTax","Custom"]
# TAX_CALCULATION_METHODS_JSON=["Exclusive","Inclusive","Compound"]
DEFAULT_TAX_CALCULATION_METHOD=Exclusive
# WITHHOLDING_CATEGORIES_JSON=["SupplierPayments","ProfessionalServices","Contractors","Dividends","Interest"]
# REVERSE_CHARGE_SCOPES_JSON=["Domestic","International","B2B","B2C"]
# TAX_EXEMPTION_TYPES_JSON=["Government","Diplomatic","Educational","Medical","Export","Charity"]
# Monthly, 1st of the month at 02:00 — real, cron-driven rule expiry
# (services/taxRuleExpiryScheduler.js).
TAX_RULE_EXPIRY_CRON_SCHEDULE="0 2 1 * *"
# TAX_REPORT_TYPES_JSON=["VATReturn","GSTReturn","SalesTaxReturn","WithholdingReturn","Custom"]
# Both skip ledger posting until configured, same "skip until configured"
# fallback as every other optional account-code pair in this module.
TAX_PAYABLE_ACCOUNT_CODE=
TAX_RECEIVABLE_ACCOUNT_CODE=
# Finance Module Part 9's original minimal tax-code -> rate lookup — kept
# ONLY as TaxService's own last-resort fallback for a taxCode with no
# matching TaxRuleModel row for the requested country/date.
# TAX_CODES_JSON=[{"code":"VAT","rate":0.15,"label":"VAT 15%"},{"code":"GST","rate":0.05,"label":"GST 5%"},{"code":"ZERO","rate":0,"label":"Zero-Rated"}]

# Enterprise Discount & Pricing Engine (utils/financeConfig.js) — Finance
# Module Part 21. "The ERP should never let individual modules calculate
# discounts independently. Instead, every module should ask a
# centralized Pricing & Discount Engine."
# PRICING_RULE_STATUSES_JSON=["Draft","Approved","Expired","Archived","Superseded"]
DEFAULT_PRICING_RULE_STATUS=Draft
PRICING_RULE_APPROVAL_REQUIRED=true
# PRICING_RULE_TYPES_JSON=["CustomerSpecific","Contract","Volume","Promotion","Loyalty"]
# Real calculation logic exists only for Percentage/FixedAmount/BuyXGetY
# — see utils/financeConfig.js's own discountTypes doc comment for why
# FreeShipping/BundleDiscount/CategoryDiscount/CustomFormula don't
# compute yet (no Shipping/Catalog/formula-engine module exists here).
# DISCOUNT_TYPES_JSON=["Percentage","FixedAmount","BuyXGetY","FreeShipping","BundleDiscount","CategoryDiscount","CustomFormula"]
# PROMOTION_TYPES_JSON=["Seasonal","Holiday","FlashSale","Campaign","LaunchOffer","Clearance","Custom"]
# COUPON_USAGE_TYPES_JSON=["SingleUse","MultiUse"]
# Monthly, 1st of the month at 03:00 — real, cron-driven rule/promotion
# expiry (services/pricingRuleExpiryScheduler.js).
PRICING_RULE_EXPIRY_CRON_SCHEDULE="0 3 1 * *"
# Maps a real, already-existing Customer.category value (Part 1) to
# "Loyalty Discounts" eligibility — no separate points-balance/loyalty-
# account system exists in this codebase to build a redemption engine
# against, so this stays a flat/percentage tier discount.
LOYALTY_CUSTOMER_CATEGORY=loyalty_member

# Enterprise Financial Approval Workflow (utils/financeConfig.js) —
# Finance Module Part 22. "The better approach is a centralized Approval
# Platform." A real, purpose-built engine — distinct from the existing
# utils/WorkflowEngine.js (Booking/Visa/Travel domain, single-role gate,
# no persisted definition); see that module's own doc comment for the
# full analysis.
# WORKFLOW_DEFINITION_STATUSES_JSON=["Draft","Approved","Expired","Archived","Superseded"]
DEFAULT_WORKFLOW_DEFINITION_STATUS=Draft
WORKFLOW_DEFINITION_APPROVAL_REQUIRED=true
# Seeded with the Finance modules that actually exist in this codebase —
# no Procurement/HR/Sales/CRM/Inventory/Projects/Payroll module exists
# yet to add here honestly.
# WORKFLOW_MODULES_JSON=["Expense","Invoice","Journal","VendorPayment","CustomerCollection","PurchaseOrder","TaxRule","PricingRule","Custom"]
# APPROVAL_TYPES_JSON=["Sequential","Parallel","AnyOne","AllRequired","MajorityVote","Conditional"]
# APPROVAL_REQUEST_STATUSES_JSON=["Pending","Escalated","Approved","Rejected","Cancelled","Expired"]
# DELEGATION_TYPES_JSON=["Temporary","Permanent","OutOfOffice"]
# Reuses Part 8's own real services/delivery/ adapters (Email/SMS/
# WhatsApp/Webhook) — Push/Teams/Slack have no real surface anywhere in
# this codebase, same honest "NotConfigured" treatment every other Part
# already gives channels without a real adapter.
# APPROVAL_NOTIFICATION_CHANNELS_JSON=["Email","SMS","WhatsApp","Push","Teams","Slack"]
DEFAULT_APPROVAL_NOTIFICATION_CHANNEL=Email
DEFAULT_APPROVAL_SLA_HOURS=48
# Hourly — real, cron-driven SLA-expiry escalation
# (services/approvalEscalationScheduler.js).
APPROVAL_ESCALATION_CRON_SCHEDULE="0 * * * *"

# Enterprise Settlement Engine (utils/financeConfig.js) — Finance Module
# Part 23. "A payment is when money is authorized or captured. A
# settlement is when the money is actually transferred and finalized."
# SETTLEMENT_STATUSES_JSON=["Pending","Sent","Processing","Completed","Failed","Reversed","Disputed","Cancelled"]
DEFAULT_SETTLEMENT_STATUS=Pending
SETTLEMENT_NUMBER_PREFIX=STL
# SETTLEMENT_BATCH_TYPES_JSON=["Daily","Weekly","Monthly","Gateway","Merchant","Manual"]
SETTLEMENT_BATCH_NUMBER_PREFIX=SBATCH
# SETTLEMENT_FEE_TYPES_JSON=["GatewayFee","BankFee","Commission","Tax","FXFee","ProcessingFee"]
# Real, per-gateway fee schedule — percent + fixed component per fee
# type, keyed by Payment's own `gateway` field, with a Default fallback.
# SETTLEMENT_FEE_SCHEDULE_JSON={"Default":{"GatewayFee":{"percent":2.9,"fixed":0.30}},"Stripe":{"GatewayFee":{"percent":2.9,"fixed":0.30}},"Manual":{"GatewayFee":{"percent":0,"fixed":0}}}
# SETTLEMENT_SPLIT_TYPES_JSON=["Marketplace","Commission","PartnerShare","VendorShare","PlatformFee"]
# SETTLEMENT_ADJUSTMENT_TYPES_JSON=["Correction","Reversal","ManualAdjustment","CompensationEntry","Chargeback"]
# Both skip ledger posting until configured, same "skip until configured"
# fallback as every other optional account-code pair in this module.
SETTLEMENT_FEE_EXPENSE_ACCOUNT_CODE=
SETTLEMENT_CLEARING_ACCOUNT_CODE=
# Settlement Reconciliation reuses Part 14's own RECONCILIATION_AMOUNT_TOLERANCE/
# RECONCILIATION_DATE_TOLERANCE_DAYS/RECONCILIATION_MATCH_WEIGHTS_JSON directly —
# no separate tolerance config for this module.
# Real gateway settlement reports (services/gateways/*.js
# fetchSettlementReport) reuse each gateway's own existing credentials —
# STRIPE_SECRET_KEY for Stripe; no new credentials needed for this Part.

# Enterprise Financial Reporting (utils/financeConfig.js) — Finance
# Module Part 24. "The reporting platform should never calculate
# business transactions directly. Instead, it should read from the
# General Ledger." A thin real aggregation layer over already-immutable
# sources (LedgerService/JournalService/TaxService/computeAgingBucket/
# ExpenseBudgetModel) — no separate calculation config needed for any of
# the underlying figures.
# REPORT_STATUSES_JSON=["Requested","Generated","Cancelled","Expired","Archived"]
DEFAULT_REPORT_STATUS=Requested
# REPORT_TYPES_JSON=["TrialBalance","BalanceSheet","ProfitAndLoss","CashFlow","GeneralLedger","JournalRegister","ARAging","APAging","TaxReport","BudgetVsActual","RetainedEarnings","Custom"]
# Real generation exists for PDF/Excel/CSV/JSON — "API" is the report's
# own real GET endpoint; "Scheduled Email" is a delivery mechanism, not a
# file format (see REPORT_SCHEDULE_FREQUENCIES_JSON below).
# REPORT_EXPORT_FORMATS_JSON=["PDF","Excel","CSV","JSON"]
# REPORT_SCHEDULE_FREQUENCIES_JSON=["Daily","Weekly","Monthly","Quarterly","Yearly"]
# Daily at 05:00 — real, cron-driven schedule runner + report-expiry
# check (services/financialReportScheduler.js).
REPORT_SCHEDULE_CRON_SCHEDULE="0 5 * * *"
# A Generated report older than this many days is eligible to expire.
# 0 disables expiry entirely.
REPORT_RETENTION_DAYS=365
# "Retained Earnings" — no dividend/distribution concept exists anywhere
# in this codebase, so that term of the formula is always 0.
RETAINED_EARNINGS_ACCOUNT_CODE=
# Scheduled report delivery reuses Part 8's own real
# services/delivery/EmailDeliveryAdapter.js (SMTP_HOST/SMTP_USER/SMTP_PASS)
# — no new credentials needed for this Part either.

# Enterprise Financial Dashboard (utils/financeConfig.js) — Finance
# Module Part 25. "A report answers 'What happened?' A dashboard answers
# 'What is happening right now?'" Extends the existing, real
# services/KPIEngine.js (Travel/Visa) with computeFinanceMetrics/
# refreshFinanceSummary, and mirrors VisaAnalyticsEngine.js/
# VisaDashboardController.js's own proven "persisted daily summary +
# CacheManager + background refresh, never aggregate transactional
# tables inline on a dashboard request" architecture — not a second,
# parallel dashboard system. No new external credentials needed.
# FINANCE_DASHBOARD_TYPES_JSON=["Executive","CFO","Treasury","AccountsReceivable","AccountsPayable","Revenue","Expense","CashFlow","Tax","Custom"]
# DASHBOARD_ALERT_TYPES_JSON=["LowCash","HighExpenses","LargePayment","OverdueReceivable","OverduePayable","BudgetExceeded","NegativeCashFlow","TaxDue","Custom"]
# DASHBOARD_ALERT_SEVERITIES_JSON=["Info","Warning","Critical"]
# DASHBOARD_REFRESH_INTERVALS_JSON=["RealTime","30Seconds","1Minute","5Minutes","Manual"]
DEFAULT_DASHBOARD_REFRESH_INTERVAL=5Minutes
DASHBOARD_CACHE_TTL_SECONDS=60
# 0 disables each threshold-driven alert below.
DASHBOARD_LOW_CASH_THRESHOLD=0
DASHBOARD_LARGE_PAYMENT_THRESHOLD=0
DASHBOARD_FX_EXPOSURE_MEDIUM_THRESHOLD=50000
DASHBOARD_FX_EXPOSURE_HIGH_THRESHOLD=250000
DASHBOARD_HIGH_EXPENSE_DAILY_THRESHOLD=0
# No due-date concept exists on a tax report, so "Tax Due" stays scoped
# to "a real outstanding liability exists this month at/above this," not
# "is overdue by N days."
DASHBOARD_TAX_DUE_THRESHOLD=0
# Custom trend-range cap already shared with Part-25-adjacent Visa
# dashboards — see DASHBOARD_TREND_MAX_RANGE_DAYS above if present, no
# separate variable needed for Finance's own trend snapshot.

# Enterprise Financial Analytics (utils/financeConfig.js) — Finance
# Module Part 26. "Reports describe. Dashboards monitor. Analytics
# explains, predicts, and helps optimize." Reads exclusively from
# already-immutable sources this codebase already has —
# LedgerService.getTrialBalance's own real historical as-of-date support
# (Part 4) and FinancialReportService.getPeriodMovement (Part 24) sampled
# at bucketed points in time — never a parallel recalculation of a
# business transaction. Forecasting is real linear regression; anomaly
# detection is a real z-score threshold — the spec's own "Machine
# Learning Models" is explicitly NOT built (see docs/05-api/07-finance-api.md
# Part 26's Deferred section). Executive Insights reuses the already-wired
# AIModelRouterService (the same real LLM router Part 15's Cash
# Forecasting already uses) — no new external credentials needed here.
# ANALYTICS_STATUSES_JSON=["Completed","Cancelled","Archived","Expired"]
# ANALYSIS_TYPES_JSON=["RevenueTrend","RevenueForecast","RevenueByCustomer","RecurringRevenue","ExpenseTrend","ExpenseForecast","ExpenseCategories","CostDrivers","CashFlowForecast","WorkingCapitalForecast","FinancialRatios","BudgetVsActual","CurrentVsPrevious","ForecastVsActual","ScenarioPlanning","AnomalyDetection","ExecutiveInsights","Custom"]
DEFAULT_ANALYTICS_STATUS=Completed
# How many trailing real GL-backed monthly buckets a Trend/Forecast
# analysis samples by default, and how many future buckets a Forecast
# projects when `period` isn't a recognizable horizon string.
ANALYTICS_TREND_BUCKETS_BACK=12
ANALYTICS_FORECAST_HORIZON_BUCKETS=3
# Below this many real historical data points, a result is honestly
# returned with confidenceLevel "Low" and insufficientData: true rather
# than fabricating a regression line through 0-2 points.
ANALYTICS_MIN_DATA_POINTS_FOR_TREND=3
ANALYTICS_CONFIDENCE_MEDIUM_DATA_POINTS=6
ANALYTICS_CONFIDENCE_HIGH_DATA_POINTS=12
# Real statistical z-score threshold for Anomaly Detection — a bucket/
# transaction whose deviation from the trailing mean exceeds this many
# standard deviations is flagged.
ANALYTICS_ANOMALY_STDDEV_THRESHOLD=2
# 0 disables expiry, same "0 = unconfigured" convention as
# REPORT_RETENTION_DAYS (Part 24).
ANALYTICS_RETENTION_DAYS=365
# "Duplicate Payments" anomaly reuses Part 7's own real
# FRAUD_DUPLICATE_WINDOW_MINUTES — no separate variable needed.
# "Cash Shortage" anomaly reuses DASHBOARD_LOW_CASH_THRESHOLD above — 0
# (default) leaves that anomaly check disabled, same as the dashboard
# alert it mirrors.

# Enterprise Audit & Compliance (utils/financeConfig.js) — Finance
# Module Part 27. Real, hash-chained, tamper-evident AuditEventModel —
# additive to the pre-existing AuditLogModel (every existing call site
# keeps working unchanged). "Digital Signature" (Tamper Detection) is
# NOT built — no real PKI/key-management infrastructure exists anywhere
# in this codebase to build one against honestly; SHA-256 hash chaining
# (Checksum/Hash Verification/Chain Verification) is real and enforced.
# "Secure Deletion" is NOT built either — it fundamentally conflicts
# with this same Part's own "Append-Only Storage"/"Immutable History" AI
# Coding Rules; Legal Hold + Archived status are the real, honest
# alternative. No new external credentials needed.
# AUDIT_EVENT_STATUSES_JSON=["Active","Archived"]
# AUDIT_CATEGORIES_JSON=["Authentication","Authorization","Financial","Inventory","HR","Security","Configuration","MasterData","System","Custom"]
# AUDIT_SEVERITIES_JSON=["Info","Warning","Critical"]
# COMPLIANCE_STATUSES_JSON=["Compliant","Violation","Exception","NotEvaluated"]
# COMPLIANCE_POLICY_TYPES_JSON=["SOX","GDPR","ISO27001","PCIDSS","HIPAA","LocalRegulation","Custom"]
# COMPLIANCE_RULE_TYPES_JSON=["SegregationOfDuties","FieldChangeRestriction","Custom"]
# SOD_CONFLICTING_PERMISSION_PAIRS_JSON=[["finance.journal.create","finance.journal.approve"], ...] — see utils/financeConfig.js for the full real, already-seeded default list.
# SOD_SUPPORTED_ENTITY_TYPES_JSON=["Journal","Invoice","AccountsPayable","Expense"]
# 7 years — 0 = unlimited. A row's own legalHold: true overrides this
# entirely regardless of value.
AUDIT_RETENTION_DAYS=2555
# Daily at 03:00 — real, cron-driven expiry (services/auditRetentionScheduler.js).
AUDIT_RETENTION_CRON_SCHEDULE="0 3 * * *"
AUDIT_EVENT_MAX_EXPORT_RECORDS=5000

# Financial Analytics Platform Enhancements — Part 29
# (utils/financeConfig.js). Extends the existing, real KPIEngine.js
# (Part 25) and FinancialAnalyticsService.js (Part 26) rather than a
# parallel Financial Analytics Platform. EBITDA add-backs are real GL
# lookups against whichever of these four account codes a tenant
# explicitly configures — 0 (collapsing EBITDA to Net Income) for
# anything left unset, honestly, not fabricated. No new external
# credentials needed.
INTEREST_EXPENSE_ACCOUNT_CODE=
INCOME_TAX_EXPENSE_ACCOUNT_CODE=
DEPRECIATION_EXPENSE_ACCOUNT_CODE=
AMORTIZATION_EXPENSE_ACCOUNT_CODE=
# FINANCE_DASHBOARD_TYPES_JSON now also accepts "CEO","Board","Department" — see utils/financeConfig.js
# ANALYSIS_TYPES_JSON now also accepts "DepartmentExpenses" — see utils/financeConfig.js

